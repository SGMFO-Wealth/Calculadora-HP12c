{
  "name": "calculadora-12c",
  "productName": "Calculadora 12C",
  "version": "1.1.0",
  "description": "Réplica de estudo da calculadora financeira HP 12C, com programação",
  "main": "main.js",
  "author": {
    "name": "Yaman Alencar",
    "url": "https://github.com/yaman-alencar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaman-alencar/Calculadora-HP12c.git"
  },
  "homepage": "https://github.com/yaman-alencar/Calculadora-HP12c#readme",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.calculadora12c.desktop",
    "productName": "Calculadora 12C",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Calculadora-12C-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1046"
    },
    "portable": {
      "artifactName": "Calculadora-12C-portatil.exe"
    },
    "copyright": "Copyright © 2026 Yaman Alencar. Licença MIT",
    "afterPack": "scripts/after-pack.js"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  }
}
